# Server
NODE_ENV=development
PORT=3001
# Must be exactly 64 hex characters (32 bytes) for AES-256-CBC
ENCRYPTION_KEY=

# Database (MongoDB Atlas)
# Get from: https://cloud.mongodb.com → Your Cluster → Connect → Drivers
MONGODB_URI=

# Clerk Authentication
# Get from: https://dashboard.clerk.com → Your App → API Keys
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Frontend origin (CORS)
CLIENT_URL=http://localhost:3000

# AI - Groq (used for AI email generation)
# NOTE: Each user sets their own Groq key in the Settings page.
# These are FALLBACK values for the server. You can leave them empty.
# Get a free key at: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192

# =============================================================
# EMAIL SENDING (SMTP) - SHARED SERVER FALLBACK (Optional)
# =============================================================
# Each user connects their OWN email account in the Settings page.
# These ENV vars are the fallback/admin SMTP used only if a user
# has NOT yet configured their own account in settings.
#
# For Gmail:
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USER=yourname@gmail.com
#   EMAIL_PASSWORD=<Google App Password>   ← NOT your real password!
#   EMAIL_FROM=Your Name <yourname@gmail.com>
#
# To create a Google App Password:
#   1. Enable 2-Step Verification at https://myaccount.google.com/security
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create a password for "Mail" and paste it here.
#
# For Outlook / Office 365:
#   EMAIL_HOST=smtp.office365.com
#   EMAIL_PORT=587
#   EMAIL_USER=yourname@outlook.com
#   EMAIL_PASSWORD=<your password>
# =============================================================
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# When true, emails are logged to console but NOT actually sent (safe for local dev)
EMAIL_TEST_MODE=true

# Minimum delay between outbound emails (ms) - prevents SMTP throttling
EMAIL_MIN_INTERVAL_MS=1000

# Admin email (gets access to /dashboard/admin)
OWNER_EMAIL=shahzaibzaman.official@gmail.com

# Inngest background jobs (https://www.inngest.com)
# Leave empty for local dev - the Inngest Dev Server handles this automatically
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_BASE_URL=