# Server
NODE_ENV=development
PORT=3001

# Database (MongoDB)
MONGODB_URI=

# Clerk authentication
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Frontend origin (CORS)
CLIENT_URL=http://localhost:3000

# AI (xAI / Grok)
XAI_API_KEY=
XAI_MODEL=grok-3-mini
XAI_BASE_URL=https://api.x.ai/v1

# Email sending (SMTP)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# When true, emails are logged instead of sent (safe for local testing)
EMAIL_TEST_MODE=false

# Minimum interval between outbound emails (application-level throttling)
EMAIL_MIN_INTERVAL_MS=1000

# Inngest background jobs (https://inngest.com)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_BASE_URL=